{
  "name": "mcp-server",
  "private": true,
  "version": "1.0.0",
  "description": "MCP tool gateway exposing project-service PM operations over stdio",
  "license": "MIT",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "devDependencies": {
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.8",
    "@types/jsonwebtoken": "^9.0.10"
  },
  "dependencies": {
    "@app/common": "workspace:*",
    "@app/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.1.19",
    "axios": "1.15.0",
    "jsonwebtoken": "^9.0.3",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "winston": "^3.17.0",
    "zod": "^4.6.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
