{
  "name": "lark-bot-service",
  "private": true,
  "version": "1.0.0",
  "description": "Workspace-scoped Lark assignment notifications for Circle",
  "license": "MIT",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint .",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@app/common": "workspace:*",
    "@app/core": "workspace:*",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.7.15",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.1.19",
    "@nestjs/microservices": "11.1.19",
    "@nestjs/platform-express": "^11.0.1",
    "helmet": "^8.1.0",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.8",
    "supertest": "^7.0.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
