TZ=UTC
NODE_ENV=local
FRONTEND_URL=

# If using Kong
KONG_DATABASE=postgres
KONG_PG_HOST=kong-ee-database
KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong
KONG_LICENSE_DATA=your_kong_enterprise_license_key
KONG_PASSWORD=replace-with-a-local-kong-password
GW_HOST=0.0.0.0

# If using Apache APISIX
APISIX_PROFILE=dev
APISIX_NODE_LISTEN=9080
APISIX_DEPLOYMENT_ADMIN_LISTEN=9180
APISIX_KEY=replace-with-a-random-apisix-key
APISIX_STAND_ALONE=false
ETCD_URL=http://etcd:2379
APISIX_HOMEPAGE_HOST=host.docker.internal
APISIX_HOMEPAGE_PORT=9280
# Service hosts below target the docker-compose service names (all services
# run as containers on nest-turbo-network). If running a service natively on
# the host instead, switch its host back to host.docker.internal.
APISIX_AUTH_SERVICE_HOST=auth-service
APISIX_AUTH_SERVICE_PORT=3301
APISIX_USER_SERVICE_HOST=user-service
APISIX_USER_SERVICE_PORT=3302
APISIX_NOTIFICATION_SERVICE_HOST=notification-service
APISIX_NOTIFICATION_SERVICE_PORT=3303
APISIX_PROJECT_SERVICE_HOST=project-service
APISIX_PROJECT_SERVICE_PORT=3304

AUTH_SERVICE_APP_PORT=3301
USER_SERVICE_APP_PORT=3302
NOTIFICATION_SERVICE_APP_PORT=3303
PROJECT_SERVICE_APP_PORT=3304

# Outbound target used by apps/mcp-server (stdio MCP process) to call project-service's REST API.
PROJECT_SERVICE_APP_URL=http://localhost:3304/circle/api
# PROJECT_ACCESS_TOKEN is a per-user secret (a project-service JWT) supplied by
# each MCP client's own config, not committed here. See apps/mcp-server/README.md.

DEFAULT_PG_DATABASE=ai-agent
DEFAULT_PG_USER=postgres
DEFAULT_PG_PASSWORD=replace-with-a-local-db-password

# Postgres host/port below target the `db` compose service on its internal
# port (5432), not the host-mapped port (5534). If running a service natively
# on the host instead, switch back to localhost:5534.
USER_SERVICE_DB_HOST=db
USER_SERVICE_DB_PORT=5432
USER_SERVICE_DB_DATABASE=ai-agent
USER_SERVICE_DB_USERNAME=postgres
USER_SERVICE_DB_PASSWORD=replace-with-a-local-db-password
PROJECT_SERVICE_DB_HOST=db
PROJECT_SERVICE_DB_PORT=5432

# Redis
#REDIS_URL=localhost:6374
REDIS_URL=redis://redis:6379

#Kafka (Optional)
#KAFKA_BROKERS=localhost:9086
KAFKA_BROKERS=kafka:9092
KAFKA_HEARTBEAT_INTERVAL=2000
KAFKA_SESSION_TIMEOUT=60000
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

#RabbitMQ (Optional)
RABBITMQ_URLS=amqp://root:replace-with-a-local-password@localhost:56725

CALL_SERVICE_TIMEOUT=30000

JWT_SECRET=replace-with-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=30d
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ISSUER=ai-agent

#gRPC config (internal service-to-service transport)
# Same value is used both as the server's bind host and as other services'
# dial target, so it must be the container's own compose service name (not
# 0.0.0.0) once everything runs in Docker. Use 0.0.0.0 only when running the
# service natively on the host.
GRPC_USER_SERVICE_HOST=user-service
GRPC_USER_SERVICE_PORT=3311
GRPC_NOTIFICATION_SERVICE_HOST=notification-service
GRPC_NOTIFICATION_SERVICE_PORT=3313

#TCP config (optional, OFF by default).
# No defaults: opting a service into Transport.TCP means setting both host and
# port here, on ports that do not clash with the gRPC listeners above.
# See docs/service-communication.md
#TCP_USER_SERVICE_HOST=0.0.0.0
#TCP_USER_SERVICE_PORT=3411
#TCP_NOTIFICATION_SERVICE_HOST=0.0.0.0
#TCP_NOTIFICATION_SERVICE_PORT=3413

# AWS SES
AWS_SES_ACCESS_KEY_ID=your-access-key
AWS_SES_ACCESS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SES_SENDER=your-sender-mail
AWS_SES_REGION=ap-southeast-1

# AWS S3
AWS_S3_REGION=ap-southeast-1
AWS_S3_ACCESS_KEY_ID=your-key
AWS_S3_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=-your-bucket
AWS_S3_URL=your-url
AWS_S3_CREDENTIALS_REQUIRED=true
STORAGE_TYPE=s3 # storage type: s3, minio

#SMTP
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_SECURE=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=circle-506504
GOOGLE_REDIRECT_URI=http://localhost:3001/login
GOOGLE_WEBHOOK_BASE_URL=
